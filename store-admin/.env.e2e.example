# Copy this file to .env.e2e. Use dedicated test accounts only.
# Never commit .env.e2e. Do not reuse production accounts.
E2E_CUSTOMER_IDENTIFIER=
E2E_CUSTOMER_PASSWORD=
E2E_STAFF_IDENTIFIER=
E2E_STAFF_PASSWORD=
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Explicit opt-in. Set to 1 ONLY for an isolated, disposable LOCAL test database.
E2E_ALLOW_MUTATIONS=0

# Optional fixtures in that same local database:
# Customer must have >= 1 order and must NOT be linked to a login account.
E2E_ORDER_CUSTOMER_ID=
# Product must belong to the order below; product is soft-deleted by this test.
E2E_ORDER_PRODUCT_ID=
E2E_ORDER_ID=
