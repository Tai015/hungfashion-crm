# Copy this file to .env.e2e. Use dedicated test accounts only.
# Never commit .env.e2e. Do not reuse production accounts.
E2E_CUSTOMER_IDENTIFIER=
E2E_CUSTOMER_PASSWORD=
E2E_STAFF_IDENTIFIER=
E2E_STAFF_PASSWORD=
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Set to 1 ONLY when E2E_BASE_URL points to an isolated LOCAL test database.
E2E_ALLOW_MUTATIONS=0

# Optional IDs from fixtures in the isolated LOCAL database:
# Customer must have at least one order; product must belong to that order.
E2E_ORDER_CUSTOMER_ID=
E2E_ORDER_ID=
E2E_ORDER_PRODUCT_ID=
