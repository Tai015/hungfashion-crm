# Copy to store-admin/.env.e2e. Use dedicated LOCAL test accounts only.
# Never commit .env.e2e or reuse production accounts.
E2E_CUSTOMER_IDENTIFIER=
E2E_CUSTOMER_PASSWORD=
E2E_STAFF_IDENTIFIER=
E2E_STAFF_PASSWORD=

# Admin credentials for local CRUD tests.
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Default safe mode: CRUD tests are skipped until explicitly enabled.
# Set to 1 ONLY when LOCAL_URL points to an isolated/disposable local database.
E2E_ALLOW_MUTATIONS=0

# Optional fixtures in that same local database.
# Customer: has >= 1 order and has NO linked login account.
E2E_ORDER_CUSTOMER_ID=
# Product must have at least one variant referenced by E2E_ORDER_ID.
E2E_ORDER_PRODUCT_ID=
E2E_ORDER_ID=
