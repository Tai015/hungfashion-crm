{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hungfashion-crm.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/products/:path*",
      "destination": "https://hungfashion-crm.onrender.com/uploads/products/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
