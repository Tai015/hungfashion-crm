PORT=5000
DEMO_PAYMENT=true
PUBLIC_BASE_URL=
# Địa chỉ website đã triển khai mà Electron mở (ví dụ https://ten-ung-dung.onrender.com).
DEPLOY_URL=
# For same-Wi-Fi scanning, use for example http://192.168.1.10:5000; for a tunnel, use its HTTPS origin.
# Set to 1 when deployed behind one trusted reverse proxy (for example Railway).
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=10
LOCAL_HOST=127.0.0.1
LOCAL_URL=http://localhost:5173
JWT_SECRET=doi-jwt-secret-trong-moi-truong-that
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=store_admin
POSTGRES_USER=store_admin
POSTGRES_PASSWORD=store_admin_dev
# Enable for external PostgreSQL providers such as Aiven; path is relative to project root.
# POSTGRES_SSL=true
# POSTGRES_CA_PATH=certs/ca.pem
KAFKA_BROKER=localhost:9092
# Optional TLS for external Kafka (for example Aiven). Relative paths start at project root.
# KAFKA_SSL_CA_PATH=certs/ca.pem
# KAFKA_SSL_CERT_PATH=certs/service.cert
# KAFKA_SSL_KEY_PATH=certs/service.key
# Or paste PEM contents using literal \n escapes:
# KAFKA_SSL_CA=
# KAFKA_SSL_CERT=
# KAFKA_SSL_KEY=
KAFKA_UI_PORT=8080
ENABLE_DATABASE_BROWSER=false
ENABLE_DATABASE_RESTORE=false
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PYTHON_EXECUTABLE=python
EVENT_RATE_LIMIT_WINDOW_MS=1000
EVENT_RATE_LIMIT_MAX=1200
OUTBOX_MAX_BACKLOG=10000
DEBUG_CHAT_SSE=false
CHAT_UPLOAD_DIR=uploads/chat
KAFKA_DB_CONFIRM_TIMEOUT_MS=60000
# Set SEED_DEMO_PASSWORD in your local environment before running the seed script.
