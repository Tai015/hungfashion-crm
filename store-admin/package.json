{
  "name": "store-admin-platform",
  "private": true,
  "version": "1.0.0",
  "main": "desktop/main.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:local": "docker compose --env-file server/.env.example up -d postgres kafka && npm run dev",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "desktop": "electron desktop/main.js",
    "desktop:config": "node scripts/prepare-desktop-config.mjs",
    "package:win": "electron-builder --win nsis zip --x64",
    "benchmark:kafka": "node scripts/kafka-load-test.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "catalog:scrape": "node scripts/scrape-catalog.mjs",
    "seed": "node scripts/seed.mjs",
    "tree:generate": "node scripts/generate-project-tree.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "sweetalert2": "^11.14.5"
  },
  "build": {
    "appId": "vn.storeadmin.launcher",
    "productName": "Store Admin",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "node_modules/sweetalert2/**/*",
      "node_modules/dotenv/**/*"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
